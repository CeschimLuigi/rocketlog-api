{
  "name": "rocketlog",
  "version": "1.0.0",
  "main": "index.js",
  "engines": {"node":">=18"},
  "scripts": {
    "dev": "tsx watch --env-file .env src/server.ts",
    "test:dev": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watchAll --runInBand",
    "build":"prisma generate && tsup src --out-dir build",
    "start": "node build/server.js",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma"
  },
  "author": "Luigi Ceschim",
  "description": "API de entregas de encomendas",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
